# Backend env vars (Supabase project + edge function secrets)
# Copy this file to .env and fill in values from your Supabase + APNs accounts.
# .env is gitignored; .env.example is safe to commit.

# ============================================================
# Supabase (from Dashboard → Project Settings → API)
# ============================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...      # public anon key (used by mobile app)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... # secret service role key (server-only)
SUPABASE_PROJECT_REF=xxxxxxxxxxxx      # 12-char project ref from URL
SUPABASE_DB_PASSWORD=                  # postgres password (Dashboard → Database → Connection string)

# ============================================================
# RevenueCat (Dashboard → Project → API keys)
# ============================================================
# REVENUECAT_PUBLIC_API_KEY=    # used in mobile app
# REVENUECAT_SECRET_API_KEY=    # used in revenuecat-webhook function
# REVENUECAT_WEBHOOK_AUTH=      # any random string; paste same value into RC dashboard webhook config

# ============================================================
# APNs (from Apple Developer → Keys → APNs key)
# ============================================================
# APNS_TEAM_ID=                 # 10-char team ID
# APNS_KEY_ID=                  # 10-char key ID
# APNS_PRIVATE_KEY_PEM=         # contents of .p8 file (with BEGIN/END markers)
# APNS_BUNDLE_ID=com.essealabs.innerproof
# APNS_HOST=api.sandbox.push.apple.com   # or api.push.apple.com for prod
